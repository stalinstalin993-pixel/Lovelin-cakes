/*
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; form-action 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: https:; connect-src 'self' https://*.supabase.co; frame-src https://www.google.com https://maps.google.com https://*.google.com; manifest-src 'self'; upgrade-insecure-requests

# Long-lived immutable assets
/images/*
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/*.woff2
  Cache-Control: public, max-age=31536000, immutable

/*.webp
  Cache-Control: public, max-age=31536000, immutable

/*.png
  Cache-Control: public, max-age=31536000, immutable

/*.svg
  Cache-Control: public, max-age=31536000, immutable

# Revalidate code on every deploy (no hashed filenames)
/styles.css
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

/app.js
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

/app.min.js
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

/admin.js
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

/admin.min.js
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

/festive.css
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

/festive.js
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

/festive.min.js
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

/*.html
  Cache-Control: public, max-age=0, must-revalidate

# Keep the admin out of search engines even if the meta tag is missed
/admin.html
  X-Robots-Tag: noindex, nofollow
